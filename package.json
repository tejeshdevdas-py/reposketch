{
  "name": "reposketch",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a public GitHub repository into an editable, source-backed architecture map.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TejeshDevdas/reposketch.git"
  },
  "homepage": "https://github.com/TejeshDevdas/reposketch#readme",
  "bugs": {
    "url": "https://github.com/TejeshDevdas/reposketch/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server shared tests docs *.md *.json *.html .github"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar-stream": "^3.1.7",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.106.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "8.3.5",
    "prettier": "^3.6.2"
  }
}
